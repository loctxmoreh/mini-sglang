ARG ROCM_VERSION=7.2
ARG UBUNTU_VERSION=24.04
ARG PYTHON_VERSION=3.12

# Build stage
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION} AS builder

ARG PYTHON_VERSION
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-dev \
        python${PYTHON_VERSION}-venv \
        build-essential \
        ninja-build \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Place tvm-ffi's JIT cache inside /app so the runtime stage's
# COPY --from=builder /app picks it up (see pre-warm step below).
ENV TVM_FFI_CACHE_DIR=/app/.cache/tvm-ffi

WORKDIR /app

# Stage 1: install locked dependencies only. Cached unless pyproject.toml
# or uv.lock change. The rocm extra routes torch to the pytorch-rocm72
# wheel index (declared in pyproject.toml [tool.uv.sources]).
COPY pyproject.toml uv.lock ./
RUN uv sync \
    --python python${PYTHON_VERSION} \
    --extra rocm \
    --frozen \
    --no-install-project

# Stage 2: install the project itself in editable mode. Source changes
# invalidate only this layer, not the dependency layer above.
COPY python/ ./python/
RUN uv sync --extra rocm --frozen

# Stage 3: pre-build the tvm-ffi DLPack addon for ROCm. The auto-loader path
# (`import tvm_ffi`) detects the GPU vendor at runtime via
# torch.cuda.is_available(), which is False during `docker build` and would
# cache the wrong (cpu) variant. Invoke the build script directly with
# --build-with-rocm so the cache holds libtorch_c_dlpack_addon_torch{M}{m}-rocm.so
# regardless of whether build-time GPU access is available.
RUN mkdir -p ${TVM_FFI_CACHE_DIR} \
    && .venv/bin/python -m tvm_ffi.utils._build_optional_torch_c_dlpack \
        --output-dir ${TVM_FFI_CACHE_DIR} \
        --libname auto \
        --build-with-rocm \
    && ls -la ${TVM_FFI_CACHE_DIR}/*.so

# Runtime stage
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION} AS runtime

ARG PYTHON_VERSION
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-venv \
        build-essential \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --shell /bin/bash --uid 1001 minisgl

# Copy application from builder
COPY --from=builder --chown=minisgl:minisgl /app /app

# Create cache directories
RUN mkdir -p /app/.cache/huggingface /app/.cache/tvm-ffi \
    && chown -R minisgl:minisgl /app/.cache

WORKDIR /app

# Environment configuration
ENV ROCM_HOME=/opt/rocm
ENV PATH="${ROCM_HOME}/bin:/app/.venv/bin:${PATH}"
ENV LD_LIBRARY_PATH="${ROCM_HOME}/lib"
ENV PYTHONUNBUFFERED=1

# Cache directories
ENV HF_HOME=/app/.cache/huggingface
ENV TVM_FFI_CACHE_DIR=/app/.cache/tvm-ffi

USER minisgl

EXPOSE 1919

ENTRYPOINT ["python", "-m", "minisgl"]
CMD ["--help"]
