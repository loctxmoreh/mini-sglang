ARG ROCM_VERSION=6.2
ARG UBUNTU_VERSION=22.04
ARG PYTHON_VERSION=3.12

# Build stage
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION} AS builder

ARG PYTHON_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 22.04 only ships python3.10 in its default repos; use deadsnakes PPA
# for python3.12.
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    curl \
    gnupg \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-dev \
    python${PYTHON_VERSION}-venv \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app

# Stage 1: install locked dependencies only. Cached unless pyproject.toml
# or uv.lock change. The ROCm extra routes torch to the pytorch-rocm62
# wheel index (declared in pyproject.toml [tool.uv.sources]).
COPY pyproject.toml uv.lock ./
RUN uv sync \
    --python python${PYTHON_VERSION} \
    --extra rocm \
    --frozen \
    --no-install-project

# Stage 2: install the project itself in editable mode. Source changes
# invalidate only this layer, not the dependency layer above.
COPY python/ ./python/
RUN uv sync --extra rocm --frozen

# Runtime stage
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION} AS runtime

ARG PYTHON_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# deadsnakes PPA needed for python3.12 on Ubuntu 22.04 (see builder stage).
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    gnupg \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-venv \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --shell /bin/bash --uid 1001 minisgl

# Copy application from builder
COPY --from=builder --chown=minisgl:minisgl /app /app

# Create cache directories
RUN mkdir -p /app/.cache/huggingface /app/.cache/tvm-ffi \
    && chown -R minisgl:minisgl /app/.cache

WORKDIR /app

# Environment configuration
ENV ROCM_HOME=/opt/rocm
ENV PATH="${ROCM_HOME}/bin:/app/.venv/bin:${PATH}"
ENV LD_LIBRARY_PATH="${ROCM_HOME}/lib:${LD_LIBRARY_PATH}"
ENV PYTHONUNBUFFERED=1

# CDNA2 / gfx90a device identifier — required by some ROCm tools that probe
# the GFX version string at runtime (e.g. triton, torch.compile)
ENV HSA_OVERRIDE_GFX_VERSION=9.0.0

# Cache directories
ENV HF_HOME=/app/.cache/huggingface
ENV TVM_FFI_CACHE_DIR=/app/.cache/tvm-ffi

USER minisgl

EXPOSE 1919

ENTRYPOINT ["python", "-m", "minisgl"]
CMD ["--help"]
